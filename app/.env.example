# Con estas variables la app se conecta a Supabase (producción).
# SIN estas variables la app RECHAZA el login: el build de producción
# nunca debe publicarse sin backend conectado.
# Para correr la demo local con mocks: VITE_DEMO_MODE=1 npm run dev
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_DEMO_MODE=1 fuerza el modo demo con mocks (solo desarrollo local)
